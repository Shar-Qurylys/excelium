# Doc-V Gateway secrets. Copy to .env (chmod 600) and fill in.
# Generate tokens: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GW_TOKEN_DOCV=replace-me
GW_TOKEN_OPS=replace-me
# Вход в веб-интерфейс /ui (пусто = интерфейс выключен)
GW_TOKEN_ADMIN=replace-me
# Секрет кода подлинности на печатных формах (лист согласования и др.);
# пусто = код не печатается
GW_VERIFY_SECRET=replace-me
# JSON dict producer-name -> token, e.g. {"onec": "abc...", "site": "def..."}
GW_PRODUCER_TOKENS={}
GW_BASE_URL=http://192.168.30.19:25353
# Путь к typst, если он не в PATH юнита (например, cargo кладёт его в
# ~/.cargo/bin). Пусто = искать в PATH и типичных каталогах.
GW_TYPST_BIN=typst
# API: только сервер Doc-V (и продюсеры заданий, если появятся)
GW_ALLOWLIST=["192.168.30.29","127.0.0.1","::1"]
# Веб-интерфейс, /health и скачивание файлов — дополнительно эти
# машины/подсети (браузеры администраторов). Первые два CIDR покрывают
# ровно 192.168.26.0–192.168.31.255, третий — пул VPN (172.16–172.31).
# Формат свободный: JSON или просто через запятую.
GW_UI_ALLOWLIST=["192.168.26.0/23","192.168.28.0/22","172.16.0.0/12"]
