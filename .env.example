# Doc-V Gateway secrets. Copy to .env (chmod 600) and fill in.
# Generate tokens: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GW_TOKEN_DOCV=replace-me
GW_TOKEN_OPS=replace-me
# Вход в веб-интерфейс /ui (пусто = интерфейс выключен)
GW_TOKEN_ADMIN=replace-me
# JSON dict producer-name -> token, e.g. {"onec": "abc...", "site": "def..."}
GW_PRODUCER_TOKENS={}
GW_BASE_URL=http://192.168.30.19:25353
# Допускаются адреса и подсети; для веб-интерфейса добавьте машины
# администраторов (или подсеть офиса)
GW_ALLOWLIST=["192.168.30.29","127.0.0.1","::1","192.168.30.0/24"]
